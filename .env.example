# Copier en .env et adapter. Le fichier .env n'est jamais commite.

# --- OpenTDB ---
# Token de session (64 caracteres hex) obtenu sur https://opentdb.com/api_token.php?command=request
# Il garantit qu'une meme question n'est pas servie deux fois pendant sa duree de vie (6h d'inactivite).
# Laisser vide pour que le scraper en demande un automatiquement.
OPENTDB_SESSION_TOKEN=
# Intervalle minimal entre deux appels API, en secondes (limite officielle : 1 appel / 5 s / IP).
OPENTDB_MIN_INTERVAL=5.2

# --- LM Studio ---
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL_KEY=google/gemma-4-12b-qat
LMSTUDIO_TIMEOUT=120

# --- Chemins de donnees ---
DATA_DIR=data
TRIVIA_DUCKDB_PATH=data/gold/benchmark.duckdb
TRIVIA_SILVER_DIR=data/silver

# --- Seuils de notation (section 9 de SPEC.md) ---
FUZZY_THRESHOLD=90
FUZZY_MARGIN=5
LOW_SAMPLE_THRESHOLD=30
